# ============================================================
# AI Farmer Helpline — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# -----------------------------------------------------------
# Google Gemini API
# Get a free key at: https://aistudio.google.com/apikey
# Used by: app.py, services/assistant.py
# -----------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------
# Flask security
# Generate a strong random key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------
FLASK_SECRET_KEY=change-this-to-a-random-secret-key

# -----------------------------------------------------------
# Admin credentials
# Generate the password hash with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your_password'))"
# -----------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=generate_with_werkzeug

# -----------------------------------------------------------
# Flask runtime
# Set FLASK_DEBUG=false in production
# -----------------------------------------------------------
FLASK_DEBUG=false

# -----------------------------------------------------------
# Rate limiting
# Format: N per <period>  (e.g. "5 per minute")
# -----------------------------------------------------------
RATE_LIMIT_PROCESS=5 per minute

# -----------------------------------------------------------
# Twilio telephony (pending credentials)
# See docs/TELEPHONY_SETUP.md for full setup instructions.
# Leave as-is to use the mock adapter (no real calls).
# -----------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TELEPHONY_PROVIDER=mock

# -----------------------------------------------------------
# AGMARKNET / data.gov.in market price API (FR-11)
# Register at: https://data.gov.in/user/register to get your key.
# Leave blank until you have registered — the app falls back to
# CSV sample data when this variable is absent or empty.
# -----------------------------------------------------------
DATA_GOV_IN_API_KEY=  # Register at data.gov.in to get this

# -----------------------------------------------------------
# Real-Time Voice Upgrade (FEAT-001 – FEAT-004)
# Set REALTIME_VOICE_ENABLED=true to activate the new voice mode.
# Leave false to keep the existing Whisper/Gemini/Edge TTS pipeline.
# -----------------------------------------------------------

# Master feature flag — defaults to false; legacy pipeline always active when false
REALTIME_VOICE_ENABLED=false

# Short-lived session TTL for real-time provider tokens (seconds)
REALTIME_SESSION_TTL_SECONDS=300

# Rate limit for real-time session creation endpoint
REALTIME_RATE_LIMIT=5 per minute

# Silero VAD: speech probability threshold (0.0–1.0)
REALTIME_VAD_THRESHOLD=0.5

# Silero VAD: minimum consecutive speech duration before utterance is accepted (ms)
REALTIME_VAD_MIN_SPEECH_MS=250

# Silero VAD: minimum silence duration before end-of-utterance is declared (ms)
REALTIME_VAD_MIN_SILENCE_MS=400

# Silero VAD: audio padding prepended before detected speech onset (ms)
REALTIME_VAD_PRE_SPEECH_PAD_MS=100

# Barge-in: debounce window — ignore VAD pulses shorter than this (ms)
REALTIME_BARGE_IN_DEBOUNCE_MS=180

# Barge-in: cooldown after an interruption before the next one is accepted (ms)
REALTIME_BARGE_IN_COOLDOWN_MS=300

# -----------------------------------------------------------
# OpenAI Realtime API (BLOCKED_PENDING_CREDENTIALS)
# Required for true full-duplex speech-to-speech (FEAT-004).
# Leave blank — the app falls back to ChunkedTTSProvider when absent.
# -----------------------------------------------------------
OPENAI_API_KEY=  # BLOCKED_PENDING_CREDENTIALS — enables true real-time STT/TTS

# -----------------------------------------------------------
# OpenRouter — free LLM inference (replaces Gemini for AI replies)
# Get a free key at: https://openrouter.ai/settings/keys
# No payment required for models ending in :free
#
# When OPENROUTER_API_KEY is set and REALTIME_VOICE_ENABLED=true,
# OpenRouterProvider is used instead of ChunkedTTSProvider (Gemini).
# Whisper STT and Edge TTS remain unchanged.
#
# NEVER expose this key in browser JS, HTML, API responses, or logs.
# -----------------------------------------------------------
OPENROUTER_API_KEY=  # Get from https://openrouter.ai/settings/keys

# Free model to use — must end in :free to prevent accidental paid calls.
# Confirmed available: nvidia/nemotron-3-ultra-550b-a55b:free
# Check current free models at: https://openrouter.ai/models?q=:free
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# =========================================================
# VoiceLink India WebSocket Bot Integration
# =========================================================
VOICELINK_ENABLED=false
VOICELINK_USERNAME=your_voicelink_username
VOICELINK_PASSWORD=your_voicelink_password
VOICELINK_WEBHOOK_SECRET=your_webhook_signature_secret
VOICELINK_PHONE_NUMBER=your_did_number
VOICELINK_BOT_WEBSOCKET_URL=wss://your-ngrok-or-cloudflare-url/integrations/voicelink/ws
VOICELINK_BOT_WEBHOOK_URL=https://your-ngrok-or-cloudflare-url/integrations/voicelink/webhook
VOICELINK_VAD_SILENCE_CHUNKS=20
VOICELINK_VAD_ENERGY_THRESHOLD=200
VOICELINK_MAX_BUFFER_CHUNKS=200
